# ContinuEd Environment Variables
# Copy this file to .env or .env.local to configure real backends

# Frontend Supabase Configuration (Optional for mock mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Nebius AI Configuration (Server-side ONLY - never expose to client!)
NEBIUS_API_KEY=your_nebius_api_key_here
PORT=5000

# Feature Flags
VITE_ENABLE_MOCK_FALLBACK=true
